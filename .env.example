# MQTT Configuration
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC_PACKETS=tshark/packets/v1
MQTT_TOPIC_DEADLETTER=tshark/dead-letter/v1
MQTT_QOS=1
MQTT_CLIENT_ID=worker-postgres-1
MQTT_SESSION_PERSISTENT=true

# Database Configuration
POSTGRES_DSN=postgresql://tshark_user:tshark_password@postgres:5432/tshark_db

# Batch Configuration
DB_BATCH_SIZE=500
DB_BATCH_FLUSH_SECONDS=1
DB_BUFFER_CAP=50000

# Observability
LOG_LEVEL=INFO
METRICS_PORT=8000

# Ingestor Configuration
TSHARK_INTERFACE=en0
TSHARK_BPF_FILTER=
TSHARK_PCAP_PATH=/data/pcap/sample.pcap
TSHARK_REPLAY_LOOP=false
MQTT_CLIENT_ID_INGESTOR=ingestor-1